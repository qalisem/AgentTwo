# NVDA Forecast Daily AI Agent (Agent #2) — Environment Variables
# Copy this file to .env and fill in the values:  cp .env.example .env

# Required: Groq API key for Llama 3.3 70B news synthesis (Action 1)
# Get one free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Recommended: Alpha Vantage key for the Action 1 news feed.
# Agent #1's current Action 1 uses Alpha Vantage NEWS_SENTIMENT (web
# scraping was abandoned 2026-05-02 — see PLANNING.md). Without this key
# Action 1 falls back to static neutral text and the pipeline still runs
# end-to-end; the article is just a placeholder until the key is added.
# Get one free at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# NOTE: No AWS / Upstash / cron variables yet. Agent #2 is local-dev only
# until AWS account access is granted. Storage is local files under data/.
